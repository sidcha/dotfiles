# Locate msmtp in $PATH so this works on Linux (/usr/bin) and macOS
# (Homebrew at /usr/local/bin or /opt/homebrew/bin) without editing.
set sendmail = "msmtp"
set alias_file = ~/Mail/alias_file
source $alias_file

# email headers
set header_cache=~/Mail/cache/headers
set message_cachedir=~/Mail/cache/bodies

# Other config files (mutt is symlinked to ~/.config/mutt by deploy.sh).
source ~/.config/mutt/common.muttrc
source ~/.config/mutt/keybindings.muttrc
source ~/.config/mutt/colors.muttrc

# default email
source ~/.config/mutt/accounts/gmail_sidcha.dev.muttrc
