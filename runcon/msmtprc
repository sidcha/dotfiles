# msmtp — outgoing SMTP for the accounts driven by mutt.
#
# Passwords are looked up via `pass` (https://www.passwordstore.org/).
# Populate the store once per account, e.g.:
#   pass insert msmtp/sidcha.dev@gmail.com
#   pass insert msmtp/sidcha.lists@gmail.com
#   pass insert msmtp/siddharth@embedjournal.com
#
# `tls_trust_file` is set to the standard Debian/Ubuntu/Raspbian cert bundle.
# On other distros/macOS, point it at the appropriate bundle (e.g.
# /etc/pki/tls/certs/ca-bundle.crt on Fedora, /etc/ssl/cert.pem on macOS
# with LibreSSL).

defaults
protocol smtp
auth on
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/Mail/log/msmtp.log

# siddharth@embedjournal.com
account ej_siddharth
host smtp.zoho.com
port 587
from siddharth@embedjournal.com
user siddharth@embedjournal.com
passwordeval "pass msmtp/siddharth@embedjournal.com"

# sidcha.lists@gmail.com
account sidcha.lists
host smtp.gmail.com
port 587
from sidcha.lists@gmail.com
user sidcha.lists@gmail.com
passwordeval "pass msmtp/sidcha.lists@gmail.com"

# sidcha.dev@gmail.com
account sidcha.dev
host smtp.gmail.com
port 587
from sidcha.dev@gmail.com
user sidcha.dev@gmail.com
passwordeval "pass msmtp/sidcha.dev@gmail.com"

account default: sidcha.dev
